<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.developer.homekit</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)cloud.homecast.app</string>
	</array>
	<key>aps-environment</key>
	<string>production</string>
	<!-- Universal links. The matching applinks section lives in
	     app-web/public/.well-known/apple-app-site-association, which is served
	     from the Firebase site for each environment. Adding this key requires the
	     Associated Domains capability on the App ID, so a provisioning profile
	     issued before this change will fail to build. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:homecast.cloud</string>
		<string>applinks:www.homecast.cloud</string>
		<string>applinks:staging.homecast.cloud</string>
		<string>webcredentials:homecast.cloud</string>
	</array>
</dict>
</plist>
