<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>cloud.homecast.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>homecast</string>
			</array>
		</dict>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Homecast</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Homecast</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.lifestyle</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>LSUIElement</key>
	<true/>
	<!-- A Community relay on the local network speaks plain HTTP, so both the
	     /health probe and the WKWebView load of the relay's own web app need an
	     ATS exception. NSAllowsLocalNetworking is the narrow key for exactly
	     this: it covers .local, link-local and private addresses and nothing
	     else, and unlike NSAllowsArbitraryLoadsInWebContent it needs no App
	     Store review justification. Relays reached over HTTPS — a tunnel, a
	     VPN with TLS, a public host — need none of this.

	     The CIDR entries are belt and braces: iOS 17 stopped exempting bare IP
	     addresses by default, and 100.64.0.0/10 is the CGNAT range Tailscale
	     hands out, which is not private address space. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>10.0.0.0/8</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>172.16.0.0/12</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>192.168.0.0/16</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>169.254.0.0/16</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>100.64.0.0/10</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>fd00::/8</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>fe80::/10</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_homecast._tcp</string>
	</array>
	<key>NSHomeKitUsageDescription</key>
	<string>Homecast needs access to your HomeKit accessories to allow remote control from the web portal.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright 2025-2026 Homecast. All rights reserved.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Homecast uses the local network to let other devices on your network control your smart home devices.</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- WebKit runs service workers only in an app that declares app-bound
	     domains, and the web app's service worker is what makes the apps open
	     instantly and work offline.

	     Declaring this key flips the default for the whole process: any web
	     view that does not set limitsNavigationsToAppBoundDomains loses script
	     injection, user scripts and message handlers — which is the entire
	     native bridge. So every web view we create opts in, and every
	     top-level origin we navigate to has to appear below.

	     Only the top-level frame is checked, so api.homecast.cloud, the MQTT
	     broker and a Community relay on the LAN need no entry — they are only
	     ever fetch/WebSocket targets. localhost is here because Community mode
	     serves the bundled web app from LocalHTTPServer. Content the app loads
	     itself (file URLs, data URLs, HTML strings — the offline error page) is
	     always treated as app-bound and needs no entry either. Limit is 10. -->
	<key>WKAppBoundDomains</key>
	<array>
		<string>homecast.cloud</string>
		<string>www.homecast.cloud</string>
		<string>staging.homecast.cloud</string>
		<string>localhost</string>
	</array>
</dict>
</plist>
