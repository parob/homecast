<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required: the Mac App Store rejects an unsandboxed executable inside a
	     sandboxed app. Upload of build 22 failed with error 90296 naming this
	     extension until this was added. Ignored on iOS. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The extension's whole job is downloading the notification's icon. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
